# DramaConsistencyAgent 运行配置模板。复制为 .env 后填入密钥。
# 全项目 4 个模型，按流水线顺序排列；其余参数都有代码默认值，不必写在这里。

# ---- ① 文本：创意 → 角色卡 + 分镜表 ----
# 模型 doubao-seed-2-1-pro-260628：把一句创意写成片名、2 个角色卡、6 镜分镜表（S1b）。
# 只写文字，不出图；关掉深度思考后 28 秒出结果，开着重 193 秒。
TEXT_API_KEY=<方舟 key>
TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_MODEL=doubao-seed-2-1-pro-260628

# ---- ② 视觉：看图和比对，全片所有「像不像」都由它判 ----
# 模型 qwen3-vl-plus，两件事：
#   1) 反推角色卡：读上传的参考图，写出外貌/服装/画风（S1a，¥0.01/张）
#   2) 一致性判定：侧背像不像正脸、首帧像不像角色卡、视频末帧有没有跑偏，
#      给 0-100 分并说明差在哪（S2b/S3/S4，¥0.01/次）
# 开深度思考：关掉会把拍摄角度造成的差异误判成「不是同一个人」。
VLM_API_KEY=<百炼 key>
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-plus

# ---- ③ 出图：定妆照 + 六镜首帧 ----
# 模型 wan2.7-image：生成每个角色的正脸定妆照、侧视背视、以及每一镜的首帧图。
# key 复用下面的 VIDEO_API_KEY（同一个百炼账号）；要独立密钥时加一行 IMAGE_NATIVE_API_KEY=
# IMAGE_PROVIDER=dashscope 表示走百炼原生接口；relay 是已停用的中转站，代码还在。
IMAGE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com
IMAGE_NATIVE_MODEL=wan2.7-image
IMAGE_PROVIDER=dashscope

# ---- ④ 出片：首帧 → 5 秒视频 ----
# 模型 wan2.2-i2v-flash：把首帧图动起来，每镜一条 720P 无声 5 秒片段（S4）。
# 声音不归它管，由 edge-tts 单独配音，避免出现双音轨。
VIDEO_API_KEY=<百炼 key>
VIDEO_BASE_URL=https://dashscope.aliyuncs.com
VIDEO_MODEL=wan2.2-i2v-flash
VIDEO_RESOLUTION=720P

# ---- 预算与单价（护栏的分母，改了模型必须同步改这里）----
# PRICE_IMAGE 必须跟着 IMAGE_PROVIDER 走：百炼 ¥0.20/张，中转站 ¥0.02/张，差 10 倍。
# PRICE_VIDEO_PER_SEC 0.2 → 5 秒一条 ¥1.00；视频占整部片成本的 73%。
BUDGET_CAP=100
PRICE_IMAGE=0.2
PRICE_VIDEO_PER_SEC=0.2
PRICE_VLM_PER_CALL=0.01

# ---- 外部依赖 ----
# FFMPEG_DIR：拼接、烧字幕用，需要 libx264 + libass；留空则从系统 PATH 找。
# TTS_SEC_VERSION：edge-tts 的版本常量，微软升级后会失效（表现为没有音频、不报错）。
FFMPEG_DIR=
TTS_SEC_VERSION=2-155.0.4283.45
